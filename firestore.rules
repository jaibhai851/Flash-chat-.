rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function memberOf(conversationId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
    }

    match /users/{uid} {
      allow read: if signedIn(); // Needed for username search; consider a callable search function for stricter privacy.
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 24;
      allow update: if isSelf(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email;
      allow delete: if isSelf(uid);
    }

    match /conversations/{conversationId} {
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 100;
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if memberOf(conversationId);
        allow create: if memberOf(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'senderId','text','createdAt','status','mediaUrl','mediaType','fileName','fileSize','replyTo'
          ])
          && (!('text' in request.resource.data) || request.resource.data.text is string)
          && (!('text' in request.resource.data) || request.resource.data.text.size() <= 4000)
          && (!('fileSize' in request.resource.data) || request.resource.data.fileSize <= 26214400);
        allow update, delete: if memberOf(conversationId)
          && resource.data.senderId == request.auth.uid;
      }
    }

    match /userSettings/{uid} {
      allow read, write: if isSelf(uid);
    }
    match /deviceTokens/{tokenId} {
      allow read, write: if signedIn() && request.resource.data.uid == request.auth.uid;
    }
    match /callSessions/{callId} {
      allow create: if signedIn() && request.auth.uid == request.resource.data.callerId;
      allow read, update: if signedIn() &&
        (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId);
      allow delete: if signedIn() &&
        (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId);
    }
  }
}